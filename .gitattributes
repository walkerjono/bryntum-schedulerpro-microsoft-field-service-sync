# Normalize text files to LF in repo, leave binaries alone
* text=auto

# Force LF for scripts (good for Linux/containers)
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf   # if you want Windows-native scripts as CRLF (optional)

# Example: force LF for common code files
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Keep images/binaries untouched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary