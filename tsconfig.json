{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "rootDir": "./src",
        "allowJs": false,
        "noEmit": true,
        "strict": true,
        "noImplicitAny": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}