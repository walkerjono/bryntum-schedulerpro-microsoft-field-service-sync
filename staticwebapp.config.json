{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.png",
      "/*.svg",
      "/assets/*.css",
      "/assets/*.js",
      "/assets/*.json",
      "/assets/*.ico",
      "/assets/*.png",
      "/assets/*.svg",
      "/assets/*.jpg",
      "/assets/*.jpeg",
      "/assets/*.gif",
      "/assets/*.webp",
      "/assets/*.woff",
      "/assets/*.woff2",
      "/assets/*.ttf",
      "/assets/*.eot",
      "/assets/*.webmanifest"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".js": "application/javascript",
    ".mjs": "application/javascript"
  }
}