{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.png",
      "*.svg",
      "/assets/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".js": "application/javascript",
    ".mjs": "application/javascript"
  }
}