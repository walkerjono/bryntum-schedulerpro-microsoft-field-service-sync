{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.js",
      "*.mjs",
      "*.json",
      "*.png",
      "*.svg",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.txt",
      "*.wasm",
      "*.webp",
      "/assets/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".js": "application/javascript",
    ".mjs": "application/javascript"
  }
}